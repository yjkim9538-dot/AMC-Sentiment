# 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 값을 채우세요.
#   (Windows PowerShell: Copy-Item .env.example .env)
# .env 는 git 에 올라가지 않습니다(비밀키 보호).

# AI 챗봇용 Anthropic API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-여기에_실제_키

# (선택) 챗봇 모델. 비우면 기본값 claude-opus-4-8.
#   비용을 낮추려면: claude-haiku-4-5
ANTHROPIC_MODEL=

# (선택) 서버 포트. 비우면 3000.
PORT=

# 접근 비밀번호. 설정하면 화면/데이터/챗봇 전체가 로그인으로 보호됩니다.
#   (비우면 누구나 접속 가능 — 사내망 배포 시 반드시 설정 권장)
APP_PASSWORD=

# (선택) 로그인 쿠키 서명용 비밀값. 비우면 매 실행마다 새로 생성되어
#   재시작 시 기존 로그인 세션이 풀립니다. 고정하려면 임의의 긴 문자열 입력.
AUTH_SECRET=
